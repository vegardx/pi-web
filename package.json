{
	"name": "@vegardx/pi-web",
	"version": "0.1.0",
	"description": "Provider-neutral search and fetch tools for Pi.",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package"
	],
	"files": [
		"dist",
		"docs",
		"README.md",
		"LICENSE"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./extension": {
			"types": "./dist/extension.d.ts",
			"import": "./dist/extension.js"
		},
		"./service-provider": {
			"types": "./dist/service-provider.d.ts",
			"import": "./dist/service-provider.js"
		}
	},
	"pi": {
		"extensions": [
			"./dist/extension.js"
		]
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "npm run build",
		"check": "biome check . && tsc --noEmit && vitest run && npm run build && npm run pack:check",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"pack:check": "node scripts/check-pack.mjs"
	},
	"engines": {
		"node": ">=23.6.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=0.84.2 <0.85",
		"@earendil-works/pi-coding-agent": ">=0.84.2 <0.85",
		"@earendil-works/pi-tui": ">=0.84.2 <0.85",
		"typebox": ">=1.3.14 <2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@earendil-works/pi-ai": "0.84.2",
		"@earendil-works/pi-coding-agent": "0.84.2",
		"@earendil-works/pi-tui": "0.84.2",
		"@types/node": "24.13.3",
		"typebox": "1.3.15",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	}
}
